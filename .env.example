# ---------------------------------------------------------------------------
# SECRETS ONLY. Copy to .env (git-ignored) and fill in real values.
# NON-secret settings (provider, thresholds, logging, Neo4j URI/user/db) live
# in config.json, NOT here. .env is exclusively for secrets.
# ---------------------------------------------------------------------------

# --- LLM provider: Anthropic Claude (only needed if config.json llm_provider="claude")
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the model id. Defaults to a sane value in code.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Local Qwen SLM (only needed if config.json llm_provider="qwen")
# Path to the GGUF model file. The model is NOT shipped in the repo.
# QWEN_GGUF_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# --- Neo4j graph store (Phase 2; only the PASSWORD is secret).
# The URI / user / database are non-secret and live in config.json.
NEO4J_PASSWORD=change-me-strong-password
